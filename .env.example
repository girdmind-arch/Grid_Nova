# Copy to .env.local and set to connect the real FastAPI backend.
# Leave unset to run on mock data.
# VITE_API_URL=http://localhost:8000

# On your Apple Silicon Mac, start the self-hosted model server on port 8001.
# For Railway to reach your Mac, set the URL to your own secure tunnel endpoint
# and set the same random token in Railway and your Mac shell environment.
# GRIDNOVA_LOCAL_MODEL_URL=http://127.0.0.1:8001/v1/chat/completions
# GRIDNOVA_LOCAL_MODEL_TOKEN=
# GRIDNOVA_MODEL_ID=mlx-community/Qwen3-1.7B-4bit
